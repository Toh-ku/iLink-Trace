{
  "name": "ilink-trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ilink-trace/web --filter @ilink-trace/daemon dev",
    "build": "pnpm --filter @ilink-trace/contracts build && pnpm --filter @ilink-trace/protocol build && pnpm --filter @ilink-trace/storage build && pnpm --filter @ilink-trace/web build && pnpm --filter @ilink-trace/daemon build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node apps/daemon/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
