# iLink Trace reads configuration only from this file when it is copied to .env.
ILINK_TRACE_PROXY_HOST=127.0.0.1
ILINK_TRACE_PROXY_PORT=8787
ILINK_TRACE_CONTROL_HOST=127.0.0.1
ILINK_TRACE_CONTROL_PORT=8788
ILINK_TRACE_PUBLIC_PROXY_ORIGIN=http://127.0.0.1:8787
ILINK_TRACE_UPSTREAM=https://ilinkai.weixin.qq.com
ILINK_TRACE_ALLOWED_UPSTREAM_HOSTS=weixin.qq.com
ILINK_TRACE_DATA_DIR=.ilink-trace
ILINK_TRACE_WEB_ROOT=apps/web/dist
ILINK_TRACE_CAPTURE_BODY_BYTES=1048576
ILINK_TRACE_CAPTURE_MESSAGE_CONTENT=false
ILINK_TRACE_RECORDER_QUEUE_SIZE=500
ILINK_TRACE_LOG_LEVEL=info
